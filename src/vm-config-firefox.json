{
  "boot-source": {
    "kernel_image_path": "/data/firecracker/vmlinux/vmlinux.bin",
    "boot_args": "console=ttyS0 reboot=k panic=1"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/data/firecracker/rootfs-firefox/firefox.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 512
  },
  "network-interfaces": [
    {
      "iface_id": "net1",
      "guest_mac": "06:00:AC:10:02:02",
      "host_dev_name": "tap2"
    }
  ]
}
